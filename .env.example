# OpenRouter offers free models when available. You may also use Groq or another
# LangChain-supported provider by changing MODEL_PROVIDER and MODEL_NAME.
MODEL_PROVIDER=openai
MODEL_NAME=openai/gpt-oss-20b:free
MODEL_API_KEY=replace_with_your_free_provider_api_key
MODEL_BASE_URL=https://openrouter.ai/api/v1

# Optional: reduce model latency / token usage
MODEL_TEMPERATURE=0.2
